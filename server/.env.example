PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/filevault

# JWT Auth Secrets
JWT_SECRET=super_secure_access_token_secret_32_bytes_long_key_2026
JWT_REFRESH_SECRET=super_secure_refresh_token_secret_32_bytes_long_key_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256 Envelope Encryption Master Key (Must be exactly 64 hex characters = 32 bytes)
ENCRYPTION_MASTER_KEY=f8a42e5d6c7b8a90123456789abcdef0123456789abcdef0123456789abcdef0

# Local Storage Directory
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads/encrypted

# AWS S3 Storage Config (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Gemini AI API Key (Optional fallback to analytical engine)
GEMINI_API_KEY=
